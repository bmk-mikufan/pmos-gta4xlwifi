# Maintainer: grgergo <csakbek@freemail.hu>
# Reference: <https://postmarketos.org/devicepkg>
pkgname=firmware-samsung-gta4xlwifi
pkgver=1
pkgrel=0
pkgdesc="Proprietary firmware for Samsung Galaxy Tab S6 Lite (Wi-Fi) (gta4xlwifi)"
url="https://github.com/TheMuppets/proprietary_vendor_samsung_gta4xl"
arch="aarch64"
license="proprietary"
options="!check !archcheck !tracedeps pmb:cross-native"

src_files="
	mx140.bin
	mx140_wlan.hcf
	mx140_wlan_sw.hcf
	slsi_reg_database.bin
"

for file in $src_files; do
	source="$source $file::https://github.com/TheMuppets/proprietary_vendor_samsung_gta4xl-common/raw/refs/heads/lineage-22.1/proprietary/vendor/etc/wifi/$file"
done

package() {
	gta4xl_dir="$pkgdir/lib/firmware/postmarketos/samsung-gta4xlwifi"
	local file
	for file in $src_files; do
		install -Dm644 "$srcdir/$file" "$gta4xl_dir/mx140/$file"
	done

	mkdir -p "$pkgdir"/vendor/etc
	ln -s /lib/firmware/postmarketos/samsung-gta4xlwifi "$pkgdir"/vendor/etc/wifi

}

