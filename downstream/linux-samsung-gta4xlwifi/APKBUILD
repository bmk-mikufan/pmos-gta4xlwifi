# Reference: <https://postmarketos.org/vendorkernel>
# Kernel config based on: arch/arm64/configs/(CHANGEME!)

pkgname=linux-samsung-gta4xlwifi
pkgver=4.14.356
pkgrel=0
pkgdesc="Samsung Galaxy Tab S6 Lite kernel fork"
arch="aarch64"
_carch="arm64"
_flavor="samsung-gta4xlwifi"
url="https://kernel.org"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
hostmakedepends=""
	makedepends="
	bash
	bc
	bison
	devicepkg-dev
	findutils
	flex
	openssl-dev
	perl
	linux-headers
	android-tools
	clang
	binutils-aarch64
"

# Compiler: clang
export CC="clang"
export HOSTCC="clang"

# Source
_repository="android_kernel_samsung_gta4xl"
_commit="df7598e4aabe7efc26c0a37871b8ee4d72dc8acb"
_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/LineageOS/$_repository/archive/$_commit.tar.gz
	$_config
	attr_fmt_arg.patch
	fix-check-lxdialog.patch
	bt.patch
	0001-SQUASH-HACK-DECON-framebuffer-fixes-for-Linux.patch
	0001-fbdev-exynos-dpu20-Remove-one-of-samsung-debug-log.patch
	exynos9611.cfg
	gta4xlwifi.cfg
	0002-abox-header-fix-redefined-param.patch
"
builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	REPLACE_GCCH=0 . downstreamkernel_prepare

	# Remove -Werror from all makefiles
	local i
	local makefiles="$(find . -type f -name Makefile)
	    $(find . -type f -name Kbuild)"
	for i in $makefiles; do
	    sed -i 's/-Werror-/-W/g' "$i"
	    sed -i 's/-Werror//g' "$i"
	done

}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	install -Dm644 "$_outdir"/arch/$_carch/boot/dts/exynos/exynos9610.dtb "$pkgdir"/boot/dtbs/exynos9610.dtb

	# Generate DTB & DTBO
	## DTB (apply configuration)
	dtbdir="$_outdir"/arch/$_carch/boot/dts/exynos
	mkdtboimg cfg_create \
		"$pkgdir"/boot/dtbs/exynos9610.dtb \
		"$srcdir"/exynos9611.cfg \
		-d "$dtbdir"

	## DTBO (create an image and apply configuration)
	dtbodir="$_outdir"/arch/$_carch/boot/dts/samsung
	mkdtboimg create "$pkgdir"/boot/dtbo.img --page_size=4096 \
		"$dtbodir"/exynos9611-gta4xlwifi*.dtbo
	mkdtboimg cfg_create \
		"$pkgdir"/boot/dtbo.img \
		"$srcdir"/gta4xlwifi.cfg \
		-d "$dtbodir"
}

