builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	REPLACE_GCCH=0
	export CC="clang-19"
	export HOSTCC="clang-19"
	. downstreamkernel_prepare
	# Remove -Werror from all makefiles
	local i
	local makefiles="$(find . -type f -name Makefile)
	    $(find . -type f -name Kbuild)"
	for i in $makefiles; do
	    sed -i 's/-Werror-/-W/g' "$i"
	    sed -i 's/-Werror//g' "$i"
	done
}

build() {
	unset LDFLAGS
	#install -Dm644 "$srcdir/exynos9610.dtb" \
		#"$pkgdir/boot/dtbs/exynos/exynos9610.dtb"

	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
	make dtbs O="$_outdir" DTC_EXT=dtc ARCH="$_carch" CC="${CC:-gcc}" V=1
	
	ls "$_outdir"/arch/"$_carch"/boot/dts/samsung
	ls "$_outdir"/arch/"$_carch"/boot/dts/exynos

}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	#make dtbs_install O="$_outdir" ARCH="$_carch" \
		#INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	#cp "$_outdir"/arch/"$_carch"/boot/dts/exynos/exynos9610.dtb "$builddir"/
	install -Dm644 '"$_outdir"/arch/"$_carch"/boot/dts/exynos/exynos9610.dtb' \
		"$pkgdir/boot/dtbs/exynos/exynos9610.dtb"



}


