prepare() {
	default_prepare
	REPLACE_GCCH=0
	export CC="clang-19"
	export HOSTCC="clang-19"
	. downstreamkernel_prepare
	# Remove -Werror from all makefiles
	local i
	local makefiles="$(find . -type f -name Makefile)
	    $(find . -type f -name Kbuild)"
	for i in $makefiles; do
	    sed -i 's/-Werror-/-W/g' "$i"
	    sed -i 's/-Werror//g' "$i"
	done
}

build() {
	unset LDFLAGS
	#install -Dm644 "$srcdir/exynos9610.dtb" \
		#"$pkgdir/boot/dtbs/exynos/exynos9610.dtb"

	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
	make dtbs O="$_outdir" DTC_EXT=dtc ARCH="$_carch" CC="${CC:-gcc}" V=1
	
	ls "$_outdir"/arch/"$_carch"/boot/dts/samsung
	ls "$_outdir"/arch/"$_carch"/boot/dts/exynos

}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	make dtbs_install O="$_outdir" ARCH="$_carch" V=1 \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	
	#cp "$_outdir"/arch/"$_carch"/boot/dts/exynos/exynos9610.dtb "$builddir"/
	#install -Dm644 "$_outdir"/arch/"$_carch"/boot/dts/exynos/exynos9610.dtb \
		#"$pkgdir/boot/dtbs/exynos/exynos9610.dtb"
	install -Dm644 "$srcdir/recovery_exynos9610.dtb" \
		"$pkgdir/boot/dtbs/exynos/exynos9610.dtb"


	# Generate DTB & DTBO
	## DTB (apply configuration)
	dtbdir="$_outdir"/arch/$_carch/boot/dts/exynos
	mkdtboimg cfg_create \
		"$pkgdir/boot/dtbs/exynos9610.dtb" \
		"$srcdir/exynos9611.cfg" \
		-d "$dtbdir"
	
	
	
	
	
	# ---------- Produce a DT TABLE image (dtb.img) that the bootloader expects ----------
	# NOTE: mkdtimg 옵션은 배포판/버전에 따라 다를 수 있음. 아래 두 가지 시도 중 성공하는 쪽을 사용.
	# 1) simple create (많은 시스템에서 동작)
	#_dtb_out="$pkgdir/boot/dtb.img"
	_dtb_out="$pkgdir//usr/share/dtb/exynos9610.dtb"
	#if ! mkdtimg create "$_dtb_out" --page_size=2048 "$pkgdir"/boot/dtbs/exynos9610.dtb ; then
	    # 2) 더 구체적인 인수(확실하지 않음 — 일부 환경에서 필요)
	    #mkdtimg create "$_dtb_out" --page_size=2048 --id=0 --rev=1 "$pkgdir"/boot/dtbs/exynos9610.dtb || true
	#fi

	# verify dt table header quickly (optional) — 도구가 없으면 주석 처리 가능
	# hexdump -C "$_dtb_out" | head -n 1


	#cp -f /usr/share/dtb/exynos9610.dtb /boot/dtbs/exynos9610.dtb



	
	## DTBO (create an image and apply configuration)
	dtbodir="$_outdir"/arch/$_carch/boot/dts/samsung
	mkdtboimg create "$pkgdir"/boot/dtbo.img --page_size=2048 \
		"$dtbodir"/exynos9611-gta4xlwifi_eur_open_00.dtbo \
		"$dtbodir"/exynos9611-gta4xlwifi_eur_open_04.dtbo \
		"$dtbodir"/exynos9611-gta4xlwifi_eur_open_05.dtbo \
		"$dtbodir"/exynos9611-gta4xlwifi_eur_open_08.dtbo \
		"$dtbodir"/exynos9611-gta4xlwifi_eur_open_09.dtbo 
		
	mkdtboimg cfg_create \
		"$pkgdir"/boot/dtbo.img \
		"$srcdir"/a51.cfg \
		-d "$dtbodir"



}


