# Maintainer: bmk <bmk@bmk.kr>
# Contributor: Alexandru Chimac <alex@chimac.ro>
pkgname=uniloader-exynos9610
pkgver=1.0
pkgrel=5
pkgdesc="Minimal bootloader for Exynos 9610/9611 devices"
arch="aarch64"
url="https://github.com/ivoszbg/uniLoader"
license="GPL-2.0-only"
options="!check !tracedeps pmb:cross-native"
depends="linux-samsung-exynos9610"
makedepends="
	bash
	clang
	llvm
	lld
	findutils
"
source="
	uniLoader-master.tar.gz::https://github.com/ivoszbg/uniLoader/archive/refs/heads/master.tar.gz
	gta4xlwifi.initramfs
"

builddir="$srcdir/uniLoader-master"

prepare() {
	default_prepare

	# This is pmb:cross-native (builds in the x86_64 native chroot), so an
	# aarch64-only makedepend on linux-samsung-exynos9610 can't be satisfied
	# here, and the /mnt/rootfs_<device> bind-mount pmbootstrap sets up
	# during `pmbootstrap install` only exists transiently -- extract the
	# kernel Image and the symbol-bearing devicetree straight out of the
	# already-built linux-samsung-exynos9610 .apk (plain tar.gz) instead.
	# The initramfs is vendored as a real source file (gta4xlwifi.initramfs,
	# generated once via mkinitfs) since it can't be built standalone inside
	# this cross-native chroot at all.
	local _kernel_apk
	_kernel_apk="$(ls -t /home/pmos/packages/pmos/aarch64/linux-samsung-exynos9610-*.apk | head -1)"
	mkdir -p blob
	tar -xzf "$_kernel_apk" -O boot/vmlinuz > blob/Image
	tar -xzf "$_kernel_apk" -O boot/dtbs/exynos/exynos9610-gta4xl.dtb > blob/dtb
	cp "$srcdir"/gta4xlwifi.initramfs blob/ramdisk
}

build() {
	unset LDFLAGS
	make ARCH="aarch64" LLVM=1 \
		gta4xl_defconfig
	make ARCH="aarch64" LLVM=1
}

package() {
	install -Dm644 "$builddir"/uniLoader \
		"$pkgdir"/usr/share/u-boot/gta4xl/uniloader.bin
}

sha512sums="
