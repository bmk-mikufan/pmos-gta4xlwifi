# Kernel config based on: arch/arm64/configs/defconfig

maintainer=""
pkgname=linux-samsung-exynos9610
pkgver=7.0.0_rc1
pkgrel=0
pkgdesc="Mainline kernel with patches for Samsung Exynos9610 support"
arch="aarch64"
_carch="arm64"
_flavor="samsung-exynos9610"
url="https://kernel.org"
license="GPL-2.0-only"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	python3
"

# Compiler: clang

# Source
_config="exynos9610.config"
source="
	linux-for-next.tar.gz::https://git.kernel.org/pub/scm/linux/kernel/git/krzk/linux.git/snapshot/linux-for-next.tar.gz
	exynos9610.config
	0001-bring-in-simplefb-earlycon.patch
	0002-video-fbdev-earlycon-Fix-compile-warning.patch
	0003-fbdev-earlycon-Protect-screen_info-struct.patch
	0004-fbdev-earlycon-Pass-NULL-to-get_default_font.patch
	0005-dt-bindings-clock-samsung-Add-Exynos9610-CMU-bindings.patch
	0006-dt-bindings-soc-exynos-sysreg-Add-Exynos9610-SYSREG-bindings.patch
	0007-clk-samsung-clk-pll-Add-support-for-pll_1061x.patch
	0008-WIP-clk-samsung-clk-pll-Add-support-for-pll_1054x.patch
	0009-clk-samsung-Introduce-Exynos9610-clock-controller-driver.patch
	0010-MAINTAINERS-Add-entry-for-Exynos9610.patch
	0011-dt-bindings-arm-samsung-Document-gta4xl-board-binding.patch
	0012-arm64-dts-exynos-Add-initial-support-for-the-Exynos9610.patch
	0013-arm64-dts-exynos-Add-initial-support-for-Samsung-Galaxy.patch
	0014-mailbox-exynos-mailbox-Add-per-SoC-doorbell-offsets.patch
	0015-firmware-samsung-exynos-acpm-Add-Exynos9610-support.patch
	0016-phy-samsung-phy-exynos5-usbdrd-Add-Exynos9610-suppo.patch
"
builddir="$srcdir/linux-for-next/"

prepare() {
	default_prepare
	cp "$srcdir"/exynos9610.config "$builddir"/arch/arm64/configs/exynos9610.config
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" \
		defconfig exynos9610.config
}

build() {
	unset LDFLAGS
	# No -j anywhere in this pmbootstrap setup (checked abuild.conf, no
	# JOBS/MAKEFLAGS default) -- make builds serially otherwise. Capped
	# below nproc: clang/lld peaks around 1GB per job on the bigger
	# translation units, and -j12 on the old 7.5GB machine got the whole
	# build OOM-killed. The box has 14GB now, so -j8 is comfortable.
	#
	# For iterating, do not use this path at all -- it re-extracts srcdir
	# every time. Use scripts/kbuild.sh (incremental, O=.output) and then
	# `pmbootstrap build --envkernel linux-samsung-exynos9610`.
	local _j="-j8"
	make ARCH="$_carch" LLVM=1 $_j \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"

	# Force dtc's -@ (symbol table generation) for exynos9610-gta4xl.dtb only,
	# via kbuild's per-target DTC_FLAGS_<target-stem> override (see
	# scripts/Makefile.dtbs: "DTC_FLAGS += $(DTC_FLAGS_$(target-stem))").
	# Without this the dtb has no __symbols__ node, and Samsung S-BOOT's UFDT
	# overlay step fails outright: "No node __symbols__ in main dtb." dtc
	# only builds -@ automatically for dtbs registered as an in-kernel-build
	# overlay base (base-dtb-y), which this board's dtb is not.
	make ARCH="$_carch" LLVM=1 $_j \
		DTC_FLAGS_exynos9610-gta4xl=-@ \
		dtbs
}

package() {
	mkdir -p "$pkgdir"/boot
	make install modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	install -Dm644 "$builddir/arch/$_carch/boot/Image" \
		"$pkgdir/boot/vmlinuz"
}

