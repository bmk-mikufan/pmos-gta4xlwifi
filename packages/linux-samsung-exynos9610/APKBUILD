# Kernel config based on: arch/arm64/configs/defconfig

maintainer=""
pkgname=linux-samsung-exynos9610
pkgver=7.0.0_rc1
pkgrel=0
pkgdesc="Mainline kernel with patches for Samsung Exynos9610 support"
arch="aarch64"
_carch="arm64"
_flavor="samsung-exynos9610"
url="https://kernel.org"
license="GPL-2.0-only"
makedepends="
	bash
	bc
	bison
	clang
	devicepkg-dev
	findutils
	flex
	lld
	llvm
	openssl-dev
	perl
	python3
"

# Compiler: clang

# Source
_config="exynos9610.config"
source="
	linux-for-next.tar.gz::https://git.kernel.org/pub/scm/linux/kernel/git/krzk/linux.git/snapshot/linux-for-next.tar.gz
	exynos9610.config
	0001-bring-in-simplefb-earlycon.patch
	0002-video-fbdev-earlycon-Fix-compile-warning.patch
	0003-fbdev-earlycon-Protect-screen_info-struct.patch
	0004-fbdev-earlycon-Pass-NULL-to-get_default_font.patch
	0001-dt-bindings-clock-samsung-Add-Exynos9610-CMU-binding.patch
	0002-clk-samsung-clk-pll-Add-support-for-pll_1061x.patch
	0003-WIP-clk-samsung-clk-pll-Add-support-for-pll_1054x.patch
	0004-clk-samsung-Introduce-Exynos9610-clock-controller-dr.patch
	0005-dt-bindings-soc-exynos-sysreg-Add-Exynos9610-SYSREG-.patch
	0006-dt-bindings-arm-samsung-Document-gta4xl-board-bindin.patch
	0007-MAINTAINERS-Add-entry-for-Samsung-Exynos9610-SoC.patch
	0008-arm64-dts-exynos-Add-initial-support-for-the-Exynos9.patch
	0009-arm64-dts-exynos-Add-initial-support-for-Samsung-Gal.patch
"
builddir="$srcdir/linux-for-next/"

prepare() {
	default_prepare
	cp "$srcdir"/exynos9610.config "$builddir"/arch/arm64/configs/exynos9610.config
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS" \
		defconfig exynos9610.config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" LLVM=1 \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
}

package() {
	mkdir -p "$pkgdir"/boot
	make install modules_install dtbs_install \
		ARCH="$_carch" \
		LLVM=1 \
		INSTALL_MOD_STRIP=1 \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_MOD_PATH="$pkgdir" \
		INSTALL_DTBS_PATH="$pkgdir/boot/dtbs"

	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"

	install -Dm644 "$builddir/arch/$_carch/boot/Image" \
		"$pkgdir/boot/vmlinuz"
}

