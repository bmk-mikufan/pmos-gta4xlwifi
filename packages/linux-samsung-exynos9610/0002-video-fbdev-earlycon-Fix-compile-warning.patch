From 0ffa077df89abf3a3adcbe9bfa397d0f8ab9dd13 Mon Sep 17 00:00:00 2001
From: Konrad Dybcio <konrad.dybcio@somainline.org>
Date: Thu, 3 Nov 2022 22:13:37 +0000
Subject: [PATCH 2/3] video: fbdev: earlycon: Fix compile warning

Fix

drivers/video/fbdev/earlycon.c:213:33: warning:
error, forbidden warning: earlycon.c:213:33
address of array 'device->options' will always evaluate to 'true' [-Wpointer-bool-conversion]
        if (!port->mapbase || !device->options)
                              ~~~~~~~~~^~~~~~~

by checking if the data exists at the address and not if the pointer
exists.
---
 drivers/video/fbdev/earlycon.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/video/fbdev/earlycon.c b/drivers/video/fbdev/earlycon.c
index 057033300c4f..9d22cb6e9db1 100644
--- a/drivers/video/fbdev/earlycon.c
+++ b/drivers/video/fbdev/earlycon.c
@@ -210,7 +210,7 @@ static int __init simplefb_earlycon_setup(struct earlycon_device *device,
 
 	si = &screen_info;
 
-	if (!port->mapbase || !device->options)
+	if (!port->mapbase || !*device->options)
 		return -ENODEV;
 
 	ret = sscanf(device->options, "%u,%u", &xres, &yres);
-- 
