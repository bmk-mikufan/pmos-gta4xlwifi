# Disable EFI for now
# CONFIG_EFI is not set

# Memory-mapped framebuffer earlycon
CONFIG_FB_EARLY=y

# Built-in DRM
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y

# Support initrd
CONFIG_BLK_DEV_INITRD=y

# UFS storage for rootfs access
CONFIG_SCSI_UFS_EXYNOS=y
CONFIG_PHY_SAMSUNG_UFS=y

# Debug for boot_delay support
CONFIG_DEBUG_KERNEL=y
CONFIG_BOOT_PRINTK_DELAY=y
CONFIG_LOG_BUF_SHIFT=21

# Watchdog (S-BOOT arms it before handoff; must probe to disarm)
CONFIG_WATCHDOG=y
CONFIG_WATCHDOG_CORE=y
CONFIG_S3C2410_WATCHDOG=y

# Pstore/ramoops for boot log capture.
# PMSG gives /dev/pmsg0, which the pmOS initramfs' setup_log() automatically
# adds to its log targets -- that is how userspace init output survives the
# reset.
#
# PSTORE_FTRACE is deliberately NOT enabled: it needs CONFIG_FUNCTION_TRACER,
# which puts -fpatchable-function-entry=2 into the global KBUILD_CFLAGS
# (arch/arm64/Makefile). That changes every compile command line, so the whole
# ccache misses and the build goes fully cold. It also grows the Image, and
# boot.img is already close to the boot partition limit.
CONFIG_PSTORE_CONSOLE=y
CONFIG_PSTORE_RAM=y
CONFIG_PSTORE_PMSG=y

# ACPM/mbox IPC (docs/upstream.md: unclaimed, free to work on)
CONFIG_MAILBOX=y
CONFIG_EXYNOS_MBOX=y
CONFIG_EXYNOS_ACPM_PROTOCOL=y

# USB2 DRD PHY + dwc3 (peripheral mode)
# libcomposite/configfs must be built in, not modules: the initramfs is
# vendored and carries modules from whatever kernel built it, so a module
# here silently fails to load after any kernel rebuild (modprobe in the
# pmOS initramfs is `2>/dev/null || true`) and the USB gadget never comes up.
CONFIG_USB_LIBCOMPOSITE=y
# Legacy g_serial gadget, built in. It binds itself to the first UDC that
# shows up, with zero userspace involvement -- unlike the configfs gadget,
# which the pmOS initramfs sets up and which is exactly the step that is
# currently failing. With U_SERIAL_CONSOLE the kernel can also log to
# ttyGS0, so the boot log reaches the host over USB instead of only the
# on-screen framebuffer. See console= in the bootargs of patch 0013.
CONFIG_USB_G_SERIAL=y
CONFIG_U_SERIAL_CONSOLE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_EXYNOS=y
CONFIG_USB_DWC3_GADGET=y
# PHY_EXYNOS5_USBDRD has 'depends on TYPEC || !TYPEC', so a modular TYPEC
# forces the PHY modular too. We need it built-in (no rootfs to modprobe
# from at the point USB has to come up), hence TYPEC=y.
CONFIG_TYPEC=y
CONFIG_PHY_EXYNOS5_USBDRD=y
CONFIG_USB_GADGET=y

# ---------------------------------------------------------------
# Config diet: arm64 defconfig turns on every SoC vendor's platform
# (~50 of them). We only ever boot Exynos, and the dead weight cost
# build time, Image size (boot.img is close to the partition limit)
# and boot time -- the boot log was full of meson/rockchip/brcm
# driver probes. Disabling ARCH_<vendor> cascades their drivers off
# via their 'depends on', so this one block does all of it.
# ---------------------------------------------------------------
# CONFIG_ARCH_ACTIONS is not set
# CONFIG_ARCH_AIROHA is not set
# CONFIG_ARCH_SUNXI is not set
# CONFIG_ARCH_ALPINE is not set
# CONFIG_ARCH_APPLE is not set
# CONFIG_ARCH_ARTPEC is not set
# CONFIG_ARCH_ASPEED is not set
# CONFIG_ARCH_AXIADO is not set
# CONFIG_ARCH_BCM is not set
# CONFIG_ARCH_BCM2835 is not set
