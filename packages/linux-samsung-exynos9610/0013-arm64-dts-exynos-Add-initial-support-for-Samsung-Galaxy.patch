From 1615da8489e65a75a731f4ba9e4e4dcd0ea87f66 Mon Sep 17 00:00:00 2001
From: Alexandru Chimac <alex@chimac.ro>
Date: Sun, 14 Sep 2025 20:44:21 +0000
Subject: [PATCH 08/12] arm64: dts: exynos: Add initial support for Samsung
 Galaxy Tab S6 Lite (gta4xl)

Add initial support for the Samsung Galaxy Tab S6 Lite (SM-P610/P615):

- Framebuffer, through SimpleFB
- RAM
- Buttons

Signed-off-by: Alexandru Chimac <alex@chimac.ro>
---
 arch/arm64/boot/dts/exynos/Makefile           |   1 +
 .../boot/dts/exynos/exynos9610-gta4xl.dts     | 112 ++++++++++++++++++
 2 files changed, 113 insertions(+)
 create mode 100644 arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts

diff --git a/arch/arm64/boot/dts/exynos/Makefile b/arch/arm64/boot/dts/exynos/Makefile
index 76cc23acb9b2..ade206665334 100644
--- a/arch/arm64/boot/dts/exynos/Makefile
+++ b/arch/arm64/boot/dts/exynos/Makefile
@@ -15,6 +15,7 @@ dtb-$(CONFIG_ARCH_EXYNOS) += \
 	exynos7885-jackpotlte.dtb	\
 	exynos850-e850-96.dtb		\
 	exynos8895-dreamlte.dtb		\
+	exynos9610-gta4xl.dtb		\
 	exynos9810-starlte.dtb		\
 	exynos990-c1s.dtb		\
 	exynos990-r8s.dtb               \
diff --git a/arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts b/arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts
new file mode 100644
index 000000000000..05c672eacde1
--- /dev/null
+++ b/arch/arm64/boot/dts/exynos/exynos9610-gta4xl.dts
@@ -0,0 +1,114 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Galaxy Tab S6 Lite device tree
+ *
+ * Copyright (c) 2025, Alexandru Chimac <alexchimac@protonmail.com>
+ */
+
+/dts-v1/;
+
+#include "exynos9610.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+	compatible = "samsung,gta4xl", "samsung,exynos9610";
+	model = "Samsung Galaxy Tab S6 Lite";
+	#address-cells = <2>;
+	#size-cells = <1>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		bootargs = "earlycon=simplefb,0xca000000,1200,2000 keep_bootcon";
+
+		framebuffer0: framebuffer@ca000000 {
+			compatible = "simple-framebuffer";
+			memory-region = <&cont_splash_rmem>;
+			width = <1200>;
+			height = <2000>;
+			stride = <(1200 * 4)>;
+			format = "a8r8g8b8";
+			clocks = <&cmu_dispaud CLK_GOUT_DISPAUD_CLK_DISPAUD_DISP>;
+		};
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3ab00000>,
+		      <0x0 0xc0000000 0x20000000>,
+		      <0x0 0xe1900000 0x1e700000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+
+	reserved-memory {
+		cont_splash_rmem: framebuffer@ca000000 {
+			reg = <0 0xca000000 (1200 * 2000 * 4)>;
+			no-map;
+		};
+
+		ramoops@f9d10000 {
+			compatible = "ramoops";
+			reg = <0x0 0xf9d10000 0x200000>;
+			record-size = <0x80000>;
+			console-size = <0x80000>;
+			ftrace-size = <0x80000>;
+			pmsg-size = <0x80000>;
+		};
+	};
+
+	gpio-keys {
+		compatible = "gpio-keys";
+
+		pinctrl-0 = <&key_voldown &key_volup &key_power>;
+		pinctrl-names = "default";
+
+		volup-key {
+			label = "Volume UP";
+			linux,code = <KEY_VOLUMEUP>;
+			gpios = <&gpa1 5 GPIO_ACTIVE_LOW>;
+		};
+
+		voldown-key {
+			label = "Volume Down";
+			linux,code = <KEY_VOLUMEDOWN>;
+			gpios = <&gpa1 6 GPIO_ACTIVE_LOW>;
+		};
+
+		power-key {
+			label = "Power";
+			linux,code = <KEY_POWER>;
+			gpios = <&gpa1 7 GPIO_ACTIVE_LOW>;
+			wakeup-source;
+		};
+	};
+};
+
+&oscclk {
+	clock-frequency = <26000000>;
+};
+
+&pinctrl_alive {
+	key_volup: key-volup-pins {
+		samsung,pins = "gpa1-5";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_voldown: key-voldown-pins {
+		samsung,pins = "gpa1-6";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+
+	key_power: key-power-pins {
+		samsung,pins = "gpa1-7";
+		samsung,pin-function = <EXYNOS_PIN_FUNC_EINT>;
+		samsung,pin-pud = <EXYNOS_PIN_PULL_NONE>;
+		samsung,pin-drv = <EXYNOS5420_PIN_DRV_LV1>;
+	};
+};
-- 
