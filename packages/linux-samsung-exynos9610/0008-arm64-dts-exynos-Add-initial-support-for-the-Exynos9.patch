+		};
+
+		sysreg_core: system-controller@12010000 {
+			compatible = "samsung,exynos9610-core-sysreg", "syscon";
+			reg = <0x12010000 0x10000>;
+			clocks = <&cmu_core CLK_GOUT_CORE_SYSREG_PCLK>;
