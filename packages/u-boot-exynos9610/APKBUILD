# Contributor:
# Maintainer:
pkgname=u-boot-exynos9610
pkgver=2026.01
pkgrel=0
pkgdesc="U-Boot for Exynos9610 devices"
url="https://source.denx.de/u-boot/u-boot"
arch="aarch64"
license="GPL-2.0-or-later OFL-1.1 BSD-2-Clause BSD-3-Clause eCos-2.0 IBM-pibs
	ISC LGPL-2.0-only LGPL-2.1-only X11"
makedepends="$depends_dev bc dtc python3-dev swig bison flex openssl-dev gnutls-dev android-tools"
options="!check !tracedeps pmb:cross-native"
source="https://ftp.denx.de/pub/u-boot/u-boot-${pkgver}.tar.bz2 0001-exynos9610.patch"
builddir="$srcdir/u-boot-${pkgver}/"

prepare() {
	default_prepare
}

build() {
	make ARCH=arm gta4xl_defconfig
	make ARCH=arm CC="${CC:-gcc}"
}

package() {
	mkdir -p "${pkgdir}/usr/share/u-boot/gta4xl/"
	install -Dm644 "${builddir}/u-boot.bin" \
		"${pkgdir}/usr/share/u-boot/gta4xl/"
	install -Dm644 "${builddir}/u-boot.dtb" \
		"${pkgdir}/usr/share/u-boot/gta4xl/exynos9610-gta4xl-uboot.dtb"

	mkdir -p "${pkgdir}/boot/dtbs/"
	# Wrap the actual mainline kernel devicetree (built with a forced dtc -@,
	# so it has a __symbols__ node) instead of u-boot's own dtb, since Samsung
	# S-BOOT's UFDT overlay step requires __symbols__ in the boot.img v2-header
	# main dtb. This is pmb:cross-native (builds in the x86_64 native chroot),
	# so an aarch64-only makedepend on linux-samsung-exynos9610 can't be
	# satisfied here -- extract the dtb straight out of the already-built
	# linux-samsung-exynos9610 .apk (a plain tar.gz, no execution/arch issue)
	# instead of relying on a makedepend install or an ephemeral rootfs mount.
	local _kernel_apk _dtb_tmp
	_kernel_apk="$(ls -t /home/pmos/packages/pmos/aarch64/linux-samsung-exynos9610-*.apk | head -1)"
	_dtb_tmp="$srcdir/exynos9610-gta4xl.dtb"
	tar -xzf "$_kernel_apk" -O boot/dtbs/exynos/exynos9610-gta4xl.dtb > "$_dtb_tmp"
	mkdtboimg create "${pkgdir}/boot/dtbs/exynos9610-gta4xl-uboot.img.dtb" \
		--custom0=0x00000000 --custom1=0xff000000 "$_dtb_tmp"
}

