diff --git a/drivers/pinctrl/exynos/pinctrl-exynos9610.c b/drivers/pinctrl/exynos/pinctrl-exynos9610.c
new file mode 100644
index 00000000000..2a80e97792b
--- /dev/null
+++ b/drivers/pinctrl/exynos/pinctrl-exynos9610.c
@@ -0,0 +1,150 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Copyright (c) 2023 Linaro Ltd.
+ * Copyright (c) 2025 Alexandru Chimac <alex@chimac.ro>
+ * Original author: Sam Protsenko <semen.protsenko@linaro.org>
+ *
+ * Exynos9610 pinctrl driver.
+ */
+
+#include <dm.h>
+#include <dm/pinctrl.h>
+#include "pinctrl-exynos.h"
+
+#define EXYNOS9610_PIN_BANK(pins, reg, id)			\
+	{							\
+		.type		= &exynos_bank_type_alive,	\
+		.offset		= reg,				\
+		.nr_pins	= pins,				\
+		.name		= id				\
+	}
+
+/* CON, DAT, PUD, DRV */
+static const struct samsung_pin_bank_type exynos_bank_type_alive = {
+	.fld_width = { 4, 1, 4, 4, },
+	.reg_offset = { 0x00, 0x04, 0x08, 0x0c, },
+};
+
+static const struct pinctrl_ops exynos9610_pinctrl_ops = {
+	.set_state = exynos_pinctrl_set_state
+};
+
+/* Exynos9610 pin-controller 0 (ALIVE) */
+static const struct samsung_pin_bank_data exynos9610_pin_banks0[] = {
+	EXYNOS9610_PIN_BANK(6, 0x000, "etc0"),
+	EXYNOS9610_PIN_BANK(8, 0x020, "gpa0"),
+	EXYNOS9610_PIN_BANK(8, 0x040, "gpa1"),
+	EXYNOS9610_PIN_BANK(8, 0x060, "gpa2"),
+	EXYNOS9610_PIN_BANK(5, 0x080, "gpq0"),
+};
+
+/* pin banks of exynos9610 pin-controller 1 (CMGP) */
+static const struct samsung_pin_bank_data exynos9610_pin_banks1[] = {
+	EXYNOS9610_PIN_BANK(1, 0x000, "gpm0"),
+	EXYNOS9610_PIN_BANK(1, 0x020, "gpm1"),
+	EXYNOS9610_PIN_BANK(1, 0x040, "gpm2"),
+	EXYNOS9610_PIN_BANK(1, 0x060, "gpm3"),
+	EXYNOS9610_PIN_BANK(1, 0x080, "gpm4"),
+	EXYNOS9610_PIN_BANK(1, 0x0A0, "gpm5"),
+	EXYNOS9610_PIN_BANK(1, 0x0C0, "gpm6"),
+	EXYNOS9610_PIN_BANK(1, 0x0E0, "gpm7"),
+	EXYNOS9610_PIN_BANK(1, 0x100, "gpm8"),
+	EXYNOS9610_PIN_BANK(1, 0x120, "gpm9"),
+	EXYNOS9610_PIN_BANK(1, 0x140, "gpm10"),
+	EXYNOS9610_PIN_BANK(1, 0x160, "gpm11"),
+	EXYNOS9610_PIN_BANK(1, 0x180, "gpm12"),
+	EXYNOS9610_PIN_BANK(1, 0x1A0, "gpm13"),
+	EXYNOS9610_PIN_BANK(1, 0x1C0, "gpm14"),
+	EXYNOS9610_PIN_BANK(1, 0x1E0, "gpm15"),
+	EXYNOS9610_PIN_BANK(1, 0x200, "gpm16"),
+	EXYNOS9610_PIN_BANK(1, 0x220, "gpm17"),
+	EXYNOS9610_PIN_BANK(1, 0x240, "gpm18"),
+	EXYNOS9610_PIN_BANK(1, 0x260, "gpm19"),
+	EXYNOS9610_PIN_BANK(1, 0x280, "gpm20"),
+	EXYNOS9610_PIN_BANK(1, 0x2A0, "gpm21"),
+	EXYNOS9610_PIN_BANK(1, 0x2C0, "gpm22"),
+	EXYNOS9610_PIN_BANK(1, 0x2E0, "gpm23"),
+	EXYNOS9610_PIN_BANK(1, 0x300, "gpm24"),
+	EXYNOS9610_PIN_BANK(1, 0x320, "gpm25"),
+};
+
+/* pin banks of exynos9610 pin-controller 2 (DISPAUD) */
+static const struct samsung_pin_bank_data exynos9610_pin_banks2[] = {
+	EXYNOS9610_PIN_BANK(5, 0x000, "gpb0"),
+	EXYNOS9610_PIN_BANK(4, 0x020, "gpb1"),
+	EXYNOS9610_PIN_BANK(5, 0x040, "gpb2"),
+};
+
+/* pin banks of exynos9610 pin-controller 3 (FSYS) */
+static const struct samsung_pin_bank_data exynos9610_pin_banks3[] = {
+	EXYNOS9610_PIN_BANK(4, 0x000, "gpf0"),
+	EXYNOS9610_PIN_BANK(8, 0x020, "gpf1"),
+	EXYNOS9610_PIN_BANK(6, 0x040, "gpf2"),
+};
+
+/* pin banks of exynos9610 pin-controller 4 (TOP) */
+static const struct samsung_pin_bank_data exynos9610_pin_banks4[] = {
+	EXYNOS9610_PIN_BANK(8, 0x000, "gpp0"),
+	EXYNOS9610_PIN_BANK(6, 0x020, "gpp1"),
+	EXYNOS9610_PIN_BANK(8, 0x040, "gpp2"),
+	EXYNOS9610_PIN_BANK(8, 0x060, "gpc0"),
+	EXYNOS9610_PIN_BANK(8, 0x080, "gpc1"),
+	EXYNOS9610_PIN_BANK(5, 0x0A0, "gpc2"),
+	EXYNOS9610_PIN_BANK(8, 0x0C0, "gpg0"),
+	EXYNOS9610_PIN_BANK(8, 0x0E0, "gpg1"),
+	EXYNOS9610_PIN_BANK(8, 0x100, "gpg2"),
+	EXYNOS9610_PIN_BANK(6, 0x120, "gpg3"),
+	EXYNOS9610_PIN_BANK(3, 0x140, "gpg4"),
+};
+
+/* pin banks of exynos9610 pin-controller 5 (SHUB) */
+static const struct samsung_pin_bank_data exynos9610_pin_banks5[] = {
+	EXYNOS9610_PIN_BANK(4, 0x000, "gph0"),
+	EXYNOS9610_PIN_BANK(3, 0x020, "gph1"),
+};
+
+static const struct samsung_pin_ctrl exynos9610_pin_ctrl[] = {
+	{
+		/* pin-controller instance 0 ALIVE data */
+		.pin_banks	= exynos9610_pin_banks0,
+		.nr_banks	= ARRAY_SIZE(exynos9610_pin_banks0),
+	},
+	{
+		/* pin-controller instance 1 CMGP data */
+		.pin_banks	= exynos9610_pin_banks1,
+		.nr_banks	= ARRAY_SIZE(exynos9610_pin_banks1),
+	}, {
+		/* pin-controller instance 2 DISPAUD data */
+		.pin_banks	= exynos9610_pin_banks2,
+		.nr_banks	= ARRAY_SIZE(exynos9610_pin_banks2),
+	}, {
+		/* pin-controller instance 3 FSYS data */
+		.pin_banks	= exynos9610_pin_banks3,
+		.nr_banks	= ARRAY_SIZE(exynos9610_pin_banks3),
+	}, {
+		/* pin-controller instance 4 TOP data */
+		.pin_banks	= exynos9610_pin_banks4,
+		.nr_banks	= ARRAY_SIZE(exynos9610_pin_banks4),
+	}, {
+		/* pin-controller instance 5 SHUB data */
+		.pin_banks	= exynos9610_pin_banks5,
+		.nr_banks	= ARRAY_SIZE(exynos9610_pin_banks5),
+	},
+	{/* list terminator */}
+};
+
+
+static const struct udevice_id exynos9610_pinctrl_ids[] = {
+	{ .compatible = "samsung,exynos9610-pinctrl",
+		.data = (ulong)exynos9610_pin_ctrl },
+	{ }
+};
+
+U_BOOT_DRIVER(pinctrl_exynos9610) = {
+	.name		= "pinctrl_exynos9610",
+	.id		= UCLASS_PINCTRL,
+	.of_match	= exynos9610_pinctrl_ids,
+	.priv_auto	= sizeof(struct exynos_pinctrl_priv),
+	.ops		= &exynos9610_pinctrl_ops,
+	.probe		= exynos_pinctrl_probe,
+};
diff --git a/dts/upstream/src/arm64/exynos/exynos9610-gta4xl.dts b/dts/upstream/src/arm64/exynos/exynos9610-gta4xl.dts
new file mode 100644
index 00000000000..78c7c11f92c
--- /dev/null
+++ b/dts/upstream/src/arm64/exynos/exynos9610-gta4xl.dts
@@ -0,0 +1,115 @@
+/dts-v1/;
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+#include "exynos9610.dtsi"
+
+/ {
+	model = "Samsung Galaxy Tab S6 Lite";
+	chassis-type = "tablet";
+	compatible = "samsung,gta4xl", "samsung,exynos9610";
+
+	#address-cells = <2>;
+	#size-cells = <1>;
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		framebuffer0: framebuffer@ca000000 {
+			compatible = "simple-framebuffer";
+			reg = <0 0xca000000 (1200 * 2000 * 4)>;
+			width = <1200>;
+			height = <2000>;
+			stride = <(1200 * 4)>;
+			format = "x8r8g8b8";
+		};
+	};
+
+	memory@80000000 {
+		device_type = "memory";
+		reg = <0x0 0x80000000 0x3ab00000>,
+		      <0x0 0xc0000000 0x20000000>,
+		      <0x0 0xe1900000 0x1e700000>,
+		      <0x8 0x80000000 0x80000000>;
+	};
+
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		camera_contig: contig@db900000 {
+			reg = <0x0 0xdb900000 0x700000>;
+			no-map;
+		};
+
+		secure_camera: seccam@e1900000 {
+			reg = <0x0 0xe1900000 0x2000000>;
+			no-map;
+		};
+
+		abox_rmem: abox@e9400000 {
