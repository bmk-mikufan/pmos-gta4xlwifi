ht-lines pre { padding-right: 3.5em; box-shadow: inset -2.75em 0 0 var(--ba=
ckground-color-neutral,#eaecf0); }

.mw-content-rtl.mw-highlight-lines pre .hll, .mw-content-rtl.content .mw-hi=
ghlight-lines pre .hll { margin-right: -3.5em; padding-right: 3.5em; }

.mw-highlight .linenos { position: absolute; box-sizing: border-box; width:=
 2.75em; background: none; color: var(--color-placeholder,#72777d); white-s=
pace: pre; }

.mw-content-ltr.mw-highlight .linenos { left: 0px; text-align: right; margi=
n-right: 4px; }

.mw-content-rtl.mw-highlight .linenos { right: 0px; text-align: left; margi=
n-left: 4px; }

.mw-highlight .linenos::before { content: attr(data-line); }

