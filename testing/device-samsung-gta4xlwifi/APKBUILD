# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-samsung-gta4xlwifi
pkgdesc="Samsung Galaxy Tab S6 Lite (Wi-Fi)"
pkgver=1
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck !strip !tracedeps pmb:cross-native"

depends="
	linux-samsung-gta4xlwifi
	mkbootimg
	postmarketos-base
	make-dynpart-mappings
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	NetworkManager-conf.d-swlan0-p2p0-unmanaged.conf
	lightdm.conf
	modules-initfs
"
subpackages="$pkgname-nonfree-firmware:nonfree_firmware"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 NetworkManager-conf.d-swlan0-p2p0-unmanaged.conf "$pkgdir"/usr/lib/NetworkManager/conf.d/swlan0-p2p0-unmanaged.conf

	install -Dm644 lightdm.conf "$pkgdir"/etc/lightdm/lightdm.conf.d/99-fix.conf
}

nonfree_firmware() {
	pkgdesc="Non-free firmware for Samsung Galaxy Tab S6 Lite (Wi-Fi) (gta4xlwifi)"
	depends="firmware-samsung-gta4xlwifi"
	mkdir "$subpkgdir"
}

