From 9410a6632aedfa4fa0dd86e7a6d14bf9bc69f793 Mon Sep 17 00:00:00 2001
From: Alexandru Chimac <alex@chimac.ro>
Date: Sun, 15 Mar 2026 16:32:12 +0200
Subject: [PATCH] fbdev: earlycon: Pass NULL to get_default_font

Commit 152609795db ("fbcon: Increase maximum font width x height to 64 x
128") changed the type of font_{w,h} from u32 to unsigned long *, changing
the value for default font size from -1 to NULL. Use the same default here.

Signed-off-by: Alexandru Chimac <alex@chimac.ro>
---
 drivers/video/fbdev/earlycon.c | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/drivers/video/fbdev/earlycon.c b/drivers/video/fbdev/earlycon.c
index 88e0c99eceb5..b8147e9f957c 100644
--- a/drivers/video/fbdev/earlycon.c
+++ b/drivers/video/fbdev/earlycon.c
@@ -229,7 +229,7 @@ static int __init simplefb_earlycon_setup(struct earlycon_device *device,
 	xres = si->lfb_width;
 	yres = si->lfb_height;
 
-	font = get_default_font(xres, yres, -1, -1);
+	font = get_default_font(xres, yres, NULL, NULL);
 	if (!font)
 		return -ENODEV;
 
-- 
2.51.0

