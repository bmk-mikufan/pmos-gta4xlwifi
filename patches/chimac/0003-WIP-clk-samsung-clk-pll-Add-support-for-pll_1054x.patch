From 1d59f24503f193e8adce6030c50630751ee9ad55 Mon Sep 17 00:00:00 2001
From: Alexandru Chimac <alex@chimac.ro>
Date: Sun, 15 Mar 2026 16:27:41 +0200
Subject: [PATCH 02/12] [WIP] clk: samsung: clk-pll: Add support for pll_1054x

This PLL type is used in the Exynos9610 SoC, and is functionally identical
to pll_0822x, so the same code can be used for it.

Signed-off-by: Alexandru Chimac <alex@chimac.ro>
---
 drivers/clk/samsung/clk-pll.c | 1 +
 drivers/clk/samsung/clk-pll.h | 1 +
 2 files changed, 2 insertions(+)

diff --git a/drivers/clk/samsung/clk-pll.c b/drivers/clk/samsung/clk-pll.c
index b51ca1095c16..be87ba4dedc5 100644
--- a/drivers/clk/samsung/clk-pll.c
+++ b/drivers/clk/samsung/clk-pll.c
@@ -1663,6 +1663,7 @@ static void __init _samsung_clk_register_pll(struct samsung_clk_provider *ctx,
 	case pll_1418x:
 	case pll_1051x:
 	case pll_1052x:
+	case pll_1054x:
 	case pll_0818x:
 	case pll_0822x:
 	case pll_0516x:
diff --git a/drivers/clk/samsung/clk-pll.h b/drivers/clk/samsung/clk-pll.h
index 44f5e99d303d..503c42fea464 100644
--- a/drivers/clk/samsung/clk-pll.h
+++ b/drivers/clk/samsung/clk-pll.h
@@ -45,6 +45,7 @@ enum samsung_pll_type {
 	pll_531x,
 	pll_1051x,
 	pll_1052x,
+	pll_1054x,
 	pll_1061x,
 	pll_0717x,
 	pll_0718x,
-- 
2.51.0

